{
  "info": {
    "name": "PayCircle REST API Collection",
    "description": "Complete Postman collection for PayCircle: Group Expense Management & Settlement Platform with Phone-number settlements and Min-Cash-Flow optimization.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "02. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Soham Chintawar\",\n  \"email\": \"soham@paycircle.app\",\n  \"phone\": \"+919876543210\",\n  \"password\": \"password123\",\n  \"upiId\": \"soham@oksbi\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login (Email or Phone)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrPhone\": \"soham@paycircle.app\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "03. User & Phone Search",
      "item": [
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            }
          }
        },
        {
          "name": "Search Users by Phone or Name",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/search?query=9876",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "search"],
              "query": [{ "key": "query", "value": "9876" }]
            }
          }
        }
      ]
    },
    {
      "name": "04. Groups",
      "item": [
        {
          "name": "Create Group",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Goa Trip 2026\",\n  \"description\": \"Beach resort & rental bikes\",\n  \"category\": \"TRIP\",\n  \"initialMemberPhones\": [\"+919876543211\", \"+919876543212\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/groups",
              "host": ["{{baseUrl}}"],
              "path": ["api", "groups"]
            }
          }
        },
        {
          "name": "List User Groups",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/groups",
              "host": ["{{baseUrl}}"],
              "path": ["api", "groups"]
            }
          }
        },
        {
          "name": "Add Member by Phone",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919876543213\",\n  \"role\": \"MEMBER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/groups/1/members",
              "host": ["{{baseUrl}}"],
              "path": ["api", "groups", "1", "members"]
            }
          }
        }
      ]
    },
    {
      "name": "05. Expenses & Splitting",
      "item": [
        {
          "name": "Create Expense (Equal Split)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupId\": 1,\n  \"title\": \"Beachfront Villa Stay\",\n  \"description\": \"3 nights villa booking\",\n  \"amount\": 12000.00,\n  \"category\": \"HOUSING_AND_RENT\",\n  \"splitType\": \"EQUAL\",\n  \"splits\": [\n    { \"userId\": 1 },\n    { \"userId\": 2 },\n    { \"userId\": 3 },\n    { \"userId\": 4 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/expenses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expenses"]
            }
          }
        },
        {
          "name": "Get Group Expenses",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/expenses/group/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "expenses", "group", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "06. Settlement Engine (Min-Cash-Flow)",
      "item": [
        {
          "name": "Calculate Group Balances & Simplified Debts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/settlements/group/1/balances",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settlements", "group", "1", "balances"]
            }
          }
        },
        {
          "name": "Get Overall User Balances Across Friends",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/settlements/overall",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settlements", "overall"]
            }
          }
        },
        {
          "name": "Record Settlement",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupId\": 1,\n  \"receiverId\": 1,\n  \"amount\": 3000.00,\n  \"paymentMethod\": \"UPI\",\n  \"transactionReference\": \"UPI9837192381\",\n  \"notes\": \"Villa share settled via Google Pay\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/settlements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "settlements"]
            }
          }
        }
      ]
    },
    {
      "name": "07. Phone-number Settlement & UPI",
      "item": [
        {
          "name": "Send Settlement Request by Phone",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientPhone\": \"+919876543211\",\n  \"amount\": 1500.00,\n  \"note\": \"Please settle flat groceries share\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payment-requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment-requests"]
            }
          }
        },
        {
          "name": "Get UPI Payment URI & Deeplinks",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payment-requests/1/upi-details",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment-requests", "1", "upi-details"]
            }
          }
        },
        {
          "name": "Accept Payment Request & Confirm Settlement",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payment-requests/1/respond?action=ACCEPT&transactionRef=UPI123456",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment-requests", "1", "respond"],
              "query": [
                { "key": "action", "value": "ACCEPT" },
                { "key": "transactionRef", "value": "UPI123456" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "08. Budgets, Analytics & Activity",
      "item": [
        {
          "name": "Get Group Budgets",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/budgets/group/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "budgets", "group", "1"]
            }
          }
        },
        {
          "name": "Get Group Spending Analytics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/analytics/group/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analytics", "group", "1"]
            }
          }
        },
        {
          "name": "Get Activity Feed",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/activity/feed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "activity", "feed"]
            }
          }
        }
      ]
    }
  ]
}
